# Names and placeholders only. Copy to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Runtime connection (pooled is fine). Your own dev or staging database; never production by accident.
DATABASE_URL="postgresql://user:password@host:6543/dbname"
# Direct (non-pooled) connection, same name as in CargoDev. Used by `npm run migrate` when
# MIGRATION_DATABASE_URL is not set. The app itself never reads it.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
# Optional. Overrides DIRECT_URL for `npm run migrate` only.
# MIGRATION_DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Customer app tokens (a separate zone). 32+ random characters, DIFFERENT from MOBILE_JWT_SECRET. Unset = customer API off.
# CUSTOMER_JWT_SECRET=replace-with-a-different-long-random-value
# true (default): anyone can register. false: only customers staff created and enabled can sign in.
# CUSTOMER_SELF_SIGNUP=true

# Signs access tokens. At least 32 random characters, different in every environment.
MOBILE_JWT_SECRET=replace-with-a-long-random-value-at-least-32-characters
# Default organization id for login lookup and the daily job.
ORG_ID=org_example

# Comma-separated browser origins allowed to call the API. Leave empty for none.
CORS_ALLOWED_ORIGINS=

# Optional. Only raises Expo push rate limits. Leave commented out unless you have one.
# EXPO_ACCESS_TOKEN=

# Number of reverse proxies we control in front of the server. 0 = trust none (default).
TRUST_PROXY_HOPS=0
# Max simultaneous notification streams on this instance.
SSE_MAX_CONNECTIONS=500
# UTC hour (0-23) the daily job runs.
DAILY_JOB_UTC_HOUR=2
# Set to false on instances that must not run scheduled jobs.
SCHEDULER_ENABLED=true

# File storage (same names as CargoDev). R2_PUBLIC_URL is needed before any file can be attached. The four R2_* credentials: all or none.
# Oldest customer app build still served (the app checks it at start). Default 1.0.0.
# APP_MIN_VERSION=1.0.0
# How long a customer's app may cache a photo or document the API serves, in seconds (0 to 86400, default 300).
# CUSTOMER_FILE_CACHE_SECONDS=300
# R2_PUBLIC_URL=https://files.example.test
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Optional email through Resend. Leave unset in development: nothing is sent, a masked notice is logged.
# RESEND_API_KEY=
# EMAIL_FROM="Example <no-reply@example.test>"

# Throwaway database for `npm run test:db` ONLY (the app never reads this). Must be localhost and a database named cargodev_test.
# TEST_DATABASE_URL=postgresql://postgres:example-throwaway-password@127.0.0.1:55432/cargodev_test
