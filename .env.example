# Names and placeholders only. Copy to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Runtime connection (pooled is fine). Your own dev or staging database; never production by accident.
DATABASE_URL="postgresql://user:password@host:6543/dbname"
# Direct (non-pooled) connection, same name as in CargoDev. Used by `npm run migrate` when
# MIGRATION_DATABASE_URL is not set. The app itself never reads it.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
# Optional. Overrides DIRECT_URL for `npm run migrate` only.
# MIGRATION_DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Customer app tokens (a separate zone). 32+ random characters, DIFFERENT from MOBILE_JWT_SECRET. Unset = customer API off.
# CUSTOMER_JWT_SECRET=replace-with-a-different-long-random-value
# Keys the HMAC that protects one-time codes. 32+ bytes, random, different from both JWT secrets.
# Required whenever CUSTOMER_JWT_SECRET is set.
# OTP_PEPPER=replace-with-another-different-long-random-value
# true (default): anyone can register. false: only customers staff created and enabled can sign in.
# CUSTOMER_SELF_SIGNUP=true

# Signs access tokens. At least 32 random characters, different in every environment.
MOBILE_JWT_SECRET=replace-with-a-long-random-value-at-least-32-characters
# Default organization id for login lookup and the daily job.
ORG_ID=org_example

# Comma-separated browser origins allowed to call the API. Leave empty for none.
CORS_ALLOWED_ORIGINS=

# Optional. Only raises Expo push rate limits. Leave commented out unless you have one.
# EXPO_ACCESS_TOKEN=

# Number of reverse proxies we control in front of the server. 0 = trust none (default).
TRUST_PROXY_HOPS=0
# Max simultaneous notification streams on this instance.
SSE_MAX_CONNECTIONS=500
# UTC hour (0-23) the daily job runs.
DAILY_JOB_UTC_HOUR=2
# Set to false on instances that must not run scheduled jobs.
SCHEDULER_ENABLED=true

# File storage (same names as CargoDev). R2_PUBLIC_URL is needed before any file can be attached. The four R2_* credentials: all or none.
# Days after shipping before staff are reminded that no arrival is recorded (then weekly). Default 45.
# ARRIVAL_REMINDER_DAYS=45
# Which deployment this is: production, staging or development (default development). Logged at start-up. It makes some checks
# stricter: the public stock image address, and (staging) email safety.
# APP_ENV=development
# Where the client address comes from (rate limits, logs): socket, hops or header. REQUIRED when NODE_ENV=production (startup fails
# without it); outside production unset means socket. In socket mode a masked warning is logged (at most once a minute) if forwarding
# headers are seen. See docs/deployment.md.
# CLIENT_IP_SOURCE=socket
# CLIENT_IP_HEADER=true-client-ip
# Database connections per instance, and the graceful-shutdown deadlines (milliseconds).
# DATABASE_POOL_MAX=10
# SHUTDOWN_TIMEOUT_MS=30000
# SCHEDULER_SHUTDOWN_TIMEOUT_MS=20000
# Oldest customer app build still served (the app checks it at start). Default 1.0.0.
# APP_MIN_VERSION=1.0.0
# How long a signed link for viewing a stored file, given to staff, stays valid (seconds, 60 to 900, default 600).
# STAFF_SIGNED_URL_TTL_SECONDS=600
# How long (0 to 300 seconds, default 30) the API remembers that a staff user is still active and which role they hold before it reads
# the database again. Changes made through this API apply at once; another instance sees them within this time. 0 turns the cache off.
# STAFF_AUTH_CACHE_SECONDS=30
# Retention (the daily job removes data that has outlived its purpose; 1 to 3650 days each). Chats and enquiries are NOT removed:
# how long they are kept is an open question (docs/privacy-checklist.md).
# DRY RUN IS THE DEFAULT, in every environment: the job only counts what it WOULD remove and logs one line of counts. Set this to
# false, on purpose, to let it delete. Exactly "true" or "false".
# RETENTION_DRY_RUN=true
# One-time codes expired more than this many days ago. Default 30.
# RETENTION_OTP_DAYS=30
# Expired or revoked sign-in sessions (customer and staff). Default 30.
# RETENTION_SESSION_DAYS=30
# READ customer alerts older than this. Unread ones are kept. Default 180.
# RETENTION_ALERT_DAYS=180
# Self-registered customers who never verified their email, and have no vehicle, chat or link request. Default 14.
# UNVERIFIED_ACCOUNT_DAYS=14
# How long a customer's app may cache a photo or document the API serves, in seconds (0 to 86400, default 300).
# CUSTOMER_FILE_CACHE_SECONDS=300
# The public website API, the staff stock tools and the enquiries inbox (all off by default).
# PUBLIC_STOCK_ENABLED=false
# Website origins allowed to call /api/public from a browser (comma-separated, never *).
# PUBLIC_ALLOWED_ORIGINS=https://www.example.test
# Where stock images are served from (a custom domain on the PUBLIC bucket) and the bucket they are uploaded to. An https address
# with no credentials, query or fragment; with APP_ENV=production an r2.dev address is refused (production needs a custom domain).
# PUBLIC_STOCK_IMAGE_BASE_URL=https://img.example.test
# R2_PUBLIC_STOCK_BUCKET_NAME=
# Cloudflare Turnstile secret for the enquiry form (optional; unset skips the check).
# TURNSTILE_SECRET=
# R2_PUBLIC_URL=https://files.example.test
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Optional email through Resend. Leave unset in development: nothing is sent, a masked notice is logged.
# RESEND_API_KEY=
# EMAIL_FROM="Example <no-reply@example.test>"

# Throwaway database for `npm run test:db` ONLY (the app never reads this). Must be localhost and a database named cargodev_test.
# TEST_DATABASE_URL=postgresql://postgres:example-throwaway-password@127.0.0.1:55432/cargodev_test
