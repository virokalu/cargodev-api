#!/bin/sh
# Pre-commit secret scan. The rules live in scripts/secret-scan.sh so CI runs the
# exact same check (git commit --no-verify skips this hook, not CI).
# The pipe's exit status is the script's, and `|| true` is not used on purpose:
# a finding must block the commit.
git diff --cached --name-only --diff-filter=ACM | sh scripts/secret-scan.sh
