# CargoDev API image. Multi-stage: the build tools never reach the final image.
#
# Base image: Node 24.22.1 on Debian 12 "bookworm" (slim), pinned to an exact tag so two builds of the same commit use the
# same runtime (a floating tag such as node:24 can change under a deploy). Debian (glibc) rather than Alpine (musl) because
# the image-resizing library (sharp) ships prebuilt binaries for both, but glibc is the most widely tested one, and there is no
# compiler or package-manager step to get wrong. Update the tag on purpose (and re-run the tests); consider pinning the digest too.
ARG NODE_IMAGE=node:24.22.1-bookworm-slim

# ---- 1. build: install everything, generate the Prisma client, compile TypeScript to dist/
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
# --ignore-scripts: no package may run code at install time. The Prisma client is generated by the explicit command below, and
# sharp needs no install script (its prebuilt binary arrives as an optional dependency).
RUN npm ci --ignore-scripts
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

# ---- 2. deps: production dependencies only, plus the generated Prisma client
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
# The client is generated from the schema (not an npm package), so it is copied from the build stage.
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

# ---- 3. runtime: no tests, docs, .env files, dev tools or TypeScript sources
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
# The base image's own unprivileged user (uid 1000). Nothing here needs root, and nothing is written to disk.
USER node
EXPOSE 4000
# A cheap static route: it answers without touching the database, so a slow database never makes the host kill the container.
# Uses the Node that is already in the image (no curl to install). PORT defaults to 4000, like the app.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
# Exec form: node is PID 1 and receives SIGTERM directly, so the graceful shutdown (src/lib/shutdown.ts) runs.
# All settings come from environment variables set on the host; no .env file is baked in or read.
CMD ["node", "dist/server.js"]
